# Clear every request header the backend trusts as identity, so a client
# cannot forge them past the Shibboleth SP into the Flask app.
#
# SECURITY-CRITICAL. This is the ONLY thing stopping header spoofing: the
# backend reads identity purely from these request headers (see
# edusign_webapp/utils.py add_attributes_to_session), and nginx passes any
# header the SP does not itself overwrite straight through. The SP overwrites
# a header only for attributes present in the current SAML session; an
# attribute the IdP did not release (e.g. mailLocalAddress) is never
# overwritten, so its forged value reaches the app unless cleared here.
#
# The list must cover every header id in attribute-map.xml, in every schema
# suffix the SP emits (-20 for SAML2, -11 for SAML1.1), plus the MD-* metadata
# headers. Matching is case-insensitive, so one entry per name is enough.
# When you add an attribute to attribute-map.xml or to SIGNER_ATTRIBUTES_* /
# AUTHN_ATTRIBUTES_*, add it here too, or it becomes spoofable.
#
# History: an earlier version cleared the "-2" suffix (a truncation of "-20")
# and so cleared nothing the app actually reads; the app reads the "-20"
# variants. That let a client forge Edupersonprincipalname-20 (the identity
# itself), Mail-20 and Maillocaladdress-20 and read other users' documents.
#
# Note: Nginx silently drops headers with underscores unless the non-default
# underscores_in_headers is enabled; these ids all use hyphens.

# Session / authentication control headers set by mod_shib.
more_clear_input_headers
    Auth-Type
    Shib-Application-Id
    Shib-Authentication-Instant
    Shib-Authentication-Method
    Shib-Authncontext-Class
    Shib-Identity-Provider
    Shib-Session-Id
    Shib-Session-Index
    Remote-User;

# Metadata-derived attributes (metadataAttributePrefix="MD-" in shibboleth2.xml).
more_clear_input_headers
    Md-Organizationname
    Md-Registrationauthority;

# Every attribute id in attribute-map.xml, with the -20 / -11 schema variants
# the SP emits. Keep in sync with attribute-map.xml.
more_clear_input_headers
    Affiliation-11
    Affiliation-20
    Cn-11
    Cn-20
    Description
    DisplayName
    DisplayName-11
    DisplayName-20
    EduPersonAssurance-11
    EduPersonAssurance-20
    EduPersonEntitlement-11
    EduPersonEntitlement-20
    EduPersonPrincipalName-11
    EduPersonPrincipalName-20
    GivenName-11
    GivenName-20
    Mail-11
    Mail-20
    MailLocalAddress-11
    MailLocalAddress-20
    NorEduPersonNIN-20
    O
    Ou
    OrganizationName-11
    OrganizationName-20
    Persistent-Id
    Persistent-Id-20
    PersonalIdentityNumber-11
    PersonalIdentityNumber-20
    PostalAddress
    Sn-11
    Sn-20
    SuAffiliation
    SuDisplayNameFirst
    SuDisplayNameLast
    SuDisplayNameLF
    SuPrimaryOrganizationID
    SuPrimaryOrganizationName
    SuRegID
    SuUnivID
    Targeted-Id
    Targeted-Id-20
    TelephoneNumber
    Title
    Uid-11
    Uid-20
    Unscoped-Affiliation-11
    Unscoped-Affiliation-20;
