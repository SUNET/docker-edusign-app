# Copy to .env and edit before running `docker compose up`.
#
# These values define the SAML SP identity that will be registered in the
# SWAMID QA federation. The entityID and base URL must match what you put
# into the SWAMID QA Metadata Tool (https://metadata.qa.swamid.se/).

# Public hostname your dev users will reach the SignService at.
# For pure-localhost dev, use 'localhost' here and 'https://localhost:8443'
# below. SWAMID may not accept a localhost entityID; use a real DNS name
# (e.g. via /etc/hosts or a tunnel) for SP registration.
SIGNSERVICE_DOMAIN=signservice.dev.local
SIGNSERVICE_BASE_URL=https://signservice.dev.local:8443

# SAML entityID of the SignService SP. Must be a stable URI you control.
SIGNSERVICE_SP_ENTITY_ID=https://signservice.dev.local/sp/integration-rest

# SignService identifier (DSS sign-service-id). Goes into the SignResponse and
# must match integration-rest's policy `sign-service-id`.
SIGNSERVICE_SIGN_SERVICE_ID=https://signservice.dev.local/signservice

# What end-users and SWAMID admins see in the SP UIInfo / Organization.
SIGNSERVICE_SP_DISPLAY_NAME=Dev SignService
SIGNSERVICE_SP_ORG_NAME=Dev Organization
SIGNSERVICE_SP_ORG_URL=https://example.org/
SIGNSERVICE_SP_CONTACT_EMAIL=dev-signservice@example.org

# FOR THE WEBAPP NGINX

MDQ_BASE_URL=https://mds.swamid.se/qa/
MDQ_SIGNER_CERT=md-signer2.crt
