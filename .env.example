MDQ_BASE_URL_EID=https://mds.swamid.se/qa/
MDQ_SIGNER_CERT_EID=md-signer2.crt
MDQ_SIGNER_CERT_URL_EID=https://mds.swamid.se/qa/md/swamid-qa.crt

